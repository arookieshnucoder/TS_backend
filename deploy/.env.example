# Runtime configuration only; never used as Docker build arguments.
COMPOSE_PROJECT_NAME=ragagent
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_MAX_INPUT_TOKENS=32768
LLM_TIMEOUT_MS=120000
CONTEXT_CHUNK_TOKENS=512
CONTEXT_OVERLAP_RATIO=0.15
CONTEXT_COMPRESSION_TRIGGER=0.65
CONTEXT_COMPRESSION_TARGET=0.08
CONTEXT_TOKENIZER=cl100k_base
CONTEXT_TOKEN_SAFETY_FACTOR=1.2
AGENT_MAX_TOOL_STEPS=4
ELASTICSEARCH_INDEX=chat-memory-v1
ES_JAVA_OPTS=-Xms512m -Xmx512m
# Set LLM_API_KEY in the launching shell or this ignored deploy/.env file.
# LLM_API_KEY=
# Optional: embedding API must be reachable FROM a container.
# To reach a Windows-hosted embedding API, use host.docker.internal instead of localhost.
# EMBEDDING_BASE_URL=http://host.docker.internal:8000/v1
# EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=
# For pulling published images (set both to the same tested release):
# BACKEND_IMAGE=ghcr.io/arookieshnucoder/ragagent-backend:release-123-1
# FRONTEND_IMAGE=ghcr.io/arookieshnucoder/ragagent-frontend:release-123-1
