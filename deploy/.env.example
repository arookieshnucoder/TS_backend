# Runtime configuration only; never used as Docker build arguments.
COMPOSE_PROJECT_NAME=ragagent
# The standard image/stack runs general AskAgent; math needs separately supplied corpus and index assets.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Enable for the GLM solver/reviewer pair (supply the GLM endpoint and model above).
ANSWER_REVIEW_ENABLED=false
ANSWER_REVIEW_MODEL=glm-4.7
ANSWER_REVIEW_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ANSWER_REVIEW_TIMEOUT_MS=120000
ANSWER_REVIEW_MAX_REVISIONS=1
# ANSWER_REVIEW_API_KEY=   # launching environment / ignored deploy/.env only
LLM_MAX_INPUT_TOKENS=32768
LLM_TIMEOUT_MS=120000
CONTEXT_CHUNK_TOKENS=512
CONTEXT_OVERLAP_RATIO=0.15
CONTEXT_COMPRESSION_TRIGGER=0.65
CONTEXT_COMPRESSION_TARGET=0.08
CONTEXT_TOKENIZER=cl100k_base
CONTEXT_TOKEN_SAFETY_FACTOR=1.2
AGENT_MAX_TOOL_STEPS=4
ELASTICSEARCH_INDEX=chat-memory-v1
ES_JAVA_OPTS=-Xms512m -Xmx512m
# Set LLM_API_KEY in the launching shell or this ignored deploy/.env file.
# LLM_API_KEY=
# Optional: embedding API must be reachable FROM a container.
# To reach a Windows-hosted embedding API, use host.docker.internal instead of localhost.
# EMBEDDING_BASE_URL=http://host.docker.internal:8000/v1
# EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=
# For pulling published images (set both to the same tested release):
# BACKEND_IMAGE=ghcr.io/arookieshnucoder/ragagent-backend:release-123-1
# FRONTEND_IMAGE=ghcr.io/arookieshnucoder/ragagent-frontend:release-123-1
AGENT_WORKSPACE_ENABLED=true
AGENT_WORKSPACE_ROOT=.
AGENT_MAX_CALLS_PER_STEP=4
AGENT_TOOL_TIMEOUT_MS=15000
AGENT_TOOL_OUTPUT_TOKENS=2048
AGENT_MODEL_RETRIES=2
AGENT_TOOL_RETRIES=1
AGENT_RETRY_BASE_DELAY_MS=250
AGENT_RETRY_MAX_DELAY_MS=3000
AGENT_MODEL_ATTEMPT_TIMEOUT_MS=30000
MCP_TIMEOUT_MS=10000
# Required for MCP Hub and run-record management in production:
# MCP_ADMIN_TOKEN=
AGENT_TRACE_ENABLED=true
AGENT_TRACE_MAX_EVENTS=512
# Optional explicit backup model, with a separate key for a different endpoint:
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
