# Server configuration

# 后端端口
PORT=8080
# 前端端口
FRONTEND_ORIGIN=http://localhost:5173

# Context harness (input limit excludes the model's output budget)
LLM_MAX_INPUT_TOKENS=32768
CONTEXT_CHUNK_TOKENS=512
CONTEXT_OVERLAP_RATIO=0.15
CONTEXT_COMPRESSION_TRIGGER=0.65
CONTEXT_COMPRESSION_TARGET=0.08
CONTEXT_TOKENIZER=cl100k_base
CONTEXT_TOKEN_SAFETY_FACTOR=1.2
AGENT_MAX_TOOL_STEPS=4

# Optional Elasticsearch. Unset = local BM25, not vector search.
# ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=chat-memory-v1
# Configure an embedding provider to enable dense-vector + BM25 hybrid search.
# EMBEDDING_BASE_URL=http://localhost:8000/v1
# EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSIONS=1536
# Set LLM_API_KEY / EMBEDDING_API_KEY / ELASTICSEARCH_API_KEY in the terminal.
