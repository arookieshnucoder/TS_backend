# Server configuration

# Shared harness solution skills: PostgreSQL is authoritative, SKILL.md is an audited export.
SOLUTION_SKILLS_ENABLED=true
# SOLUTION_SKILLS_DIR=./data/solution-skills
SOLUTION_SKILLS_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# SOLUTION_SKILLS_DATABASE_URL falls back to AUTH_DATABASE_URL / process PG* settings.
# Database URLs and SOLUTION_SKILLS_EMBEDDING_API_KEY are process-only credentials.

# Dedicated junior mathematics agent (general restores the original AskAgent).
MATH_AGENT_VARIANT=adaptive
# auto routes explicit reading tasks to the Chinese harness, leaving mathematical requests on the same profile.
SCHOOL_SUBJECT=auto
READING_AGENT_VARIANT=adaptive
READING_CONTEXT_TOKENS=1400
ENGLISH_AGENT_VARIANT=adaptive
ENGLISH_WORKFLOW=grounded
ENGLISH_THINKING=disabled
ENGLISH_CONTEXT_TOKENS=1800
# ENGLISH_CORPUS_PATH=./evals/english/corpus.json
# READING_CORPUS_PATH=./evals/chinese/corpus.json
MATH_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_THINKING=enabled
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.5-air
# Independent answer review runs after mathematics, Chinese and English workflows.
ANSWER_REVIEW_ENABLED=true
ANSWER_REVIEW_MODEL=glm-4.7
# Review reasoning is independent of GLM_THINKING; retain it for reliable validation.
ANSWER_REVIEW_THINKING=enabled
ANSWER_REVIEW_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ANSWER_REVIEW_TIMEOUT_MS=120000
ANSWER_REVIEW_MAX_REVISIONS=1
# Same endpoint reuses LLM_API_KEY. For a different endpoint set ANSWER_REVIEW_API_KEY in the terminal.
# Set LLM_API_KEY in the terminal, never in this file.

# 后端端口
PORT=8080
# 前端端口
FRONTEND_ORIGIN=http://localhost:5173

# Context harness (input limit excludes the model's output budget)
LLM_MAX_INPUT_TOKENS=32768
CONTEXT_CHUNK_TOKENS=512
CONTEXT_OVERLAP_RATIO=0.15
CONTEXT_COMPRESSION_TRIGGER=0.65
CONTEXT_COMPRESSION_TARGET=0.08
CONTEXT_TOKENIZER=cl100k_base
CONTEXT_TOKEN_SAFETY_FACTOR=1.2
AGENT_MAX_TOOL_STEPS=6
AGENT_MAX_CALLS_PER_STEP=4
AGENT_TOOL_TIMEOUT_MS=15000
AGENT_TOOL_OUTPUT_TOKENS=2048
# Run-wide protocol repair budget; 0 restores strict fail-fast behavior.
AGENT_PROTOCOL_REPAIRS=1
# Initial/each discovery batch limit; omitted authorized tools can be found via tool_search.
AGENT_MAX_MCP_TOOLS=8
# Ask Agent reads this workspace only. Relative paths resolve from the backend directory.
AGENT_WORKSPACE_ENABLED=true
AGENT_WORKSPACE_ROOT=.
# Use .. to include sibling frontend/ and vscode/ source trees.

# Optional Elasticsearch. Unset = local BM25, not vector search.
# ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=chat-memory-v1
# Configure an embedding provider to enable dense-vector + BM25 hybrid search.
# EMBEDDING_BASE_URL=http://localhost:8000/v1
# EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSIONS=1536
# Set LLM_API_KEY / EMBEDDING_API_KEY / ELASTICSEARCH_API_KEY in the terminal.

# MCP catalog defaults to data/mcp-servers.json (outside session JSON directory).
# MCP_CONFIG_FILE=./data/mcp-servers.json
MCP_TIMEOUT_MS=10000
# Set MCP_ADMIN_TOKEN in the process environment to allow authenticated remote administration.
# Credential values in MCP env/headers may reference ${ENVIRONMENT_VARIABLE}.

# Harness retries transient failures only. Zero disables retries.
AGENT_MODEL_RETRIES=2
AGENT_TOOL_RETRIES=1
AGENT_RETRY_BASE_DELAY_MS=250
AGENT_RETRY_MAX_DELAY_MS=3000
AGENT_MODEL_ATTEMPT_TIMEOUT_MS=60000
# Optional explicit fallback model. Same endpoint can reuse LLM_API_KEY.
# LLM_FALLBACK_MODEL=your-backup-model
# LLM_FALLBACK_BASE_URL=https://your-backup-provider/v1
# A different endpoint requires LLM_FALLBACK_API_KEY in the process environment.

# Per-question traces. Defaults to a sibling directory named sessions-runs.
AGENT_TRACE_ENABLED=true
AGENT_TRACE_MAX_EVENTS=512
# AGENT_RUN_DATA_DIR=./data/runs

# Unified email login. Database credentials are read from the launching process only.
AUTH_ENABLED=true
AUTH_DB_DRIVER=postgres
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=604800
# PowerShell: $env:AUTH_DATABASE_URL = 'postgresql://user:URL_ENCODED_PASSWORD@localhost:5432/songjian'
# AUTH_DATABASE_URL in this file is deliberately ignored. PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE are also supported process variables.
